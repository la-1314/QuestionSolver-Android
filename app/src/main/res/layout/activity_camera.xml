<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:fitsSystemWindows="false">

    <!-- 相机预览：填满全屏 -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:scaleType="fillCenter"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 顶部控制条：返回 / 闪光灯 -->
    <FrameLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="24dp"
        android:paddingHorizontal="12dp"
        android:paddingBottom="8dp"
        android:background="@drawable/scrim_top"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClose"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start|center_vertical"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            app:cornerRadius="24dp"
            app:icon="@drawable/ic_close"
            app:iconSize="22dp"
            app:iconGravity="textTop"
            app:strokeColor="@android:color/white"
            app:backgroundTint="#80000000"
            app:iconTint="@android:color/white" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFlash"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end|center_vertical"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            app:cornerRadius="24dp"
            app:icon="@drawable/ic_flash"
            app:iconSize="22dp"
            app:iconGravity="textTop"
            app:strokeColor="@android:color/white"
            app:backgroundTint="#80000000"
            app:iconTint="@android:color/white" />
    </FrameLayout>

    <!-- 右侧变焦滑条：1x ~ 5x -->
    <LinearLayout
        android:id="@+id/zoomPanel"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="80dp"
        android:layout_marginBottom="180dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/scrim_round"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvZoomValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1.0x"
            android:textColor="@android:color/white"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:layout_marginBottom="6dp" />

        <androidx.appcompat.widget.AppCompatSeekBar
            android:id="@+id/zoomSlider"
            android:layout_width="180dp"
            android:layout_height="wrap_content"
            android:rotation="270"
            android:max="40"
            android:progress="0"
            android:progressTint="@android:color/white"
            android:thumbTint="@color/md_accent" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1x · 5x"
            android:textColor="@android:color/white"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:layout_marginTop="6dp" />
    </LinearLayout>

    <!-- 底部控制条：图库 / 快门 / 变焦预设 -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/scrim_bottom"
        android:paddingTop="16dp"
        android:paddingHorizontal="24dp"
        android:paddingBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGallery"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                app:cornerRadius="24dp"
                app:icon="@android:drawable/ic_menu_gallery"
                app:iconSize="22dp"
                app:iconGravity="textTop"
                app:strokeColor="@android:color/white"
                app:backgroundTint="#80000000"
                app:iconTint="@android:color/white" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnZoomPreset"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                app:cornerRadius="30dp"
                android:text="1x"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:strokeColor="@android:color/white"
                app:strokeWidth="2dp"
                app:backgroundTint="#80000000" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCapture"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_gravity="center"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                app:cornerRadius="38dp"
                app:backgroundTint="@android:color/white"
                app:strokeColor="@color/md_accent"
                app:strokeWidth="5dp" />
        </FrameLayout>

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/camera_capture"
            android:textColor="#B3FFFFFF"
            android:textAppearance="?attr/textAppearanceLabelMedium" />
    </LinearLayout>

    <!-- Loading 蒙层 -->
    <FrameLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#CC000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                app:indicatorColor="@android:color/white" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvLoading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@android:color/white"
                android:text="@string/loading" />
        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
