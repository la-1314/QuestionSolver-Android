<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
        Base application theme (Material Design 3 + Material You 动态取色)
        parent=Theme.Material3.DynamicColors.DayNight.NoActionBar 会在 Android 12+
        自动从壁纸提取色板注入 colorPrimary/colorSurface 等属性；
        低于 12 时回退到 Material3 baseline 紫色配色。
        Compose 层的动态色由 MiuixTheme(ColorSchemeMode.MonetSystem) 单独处理。
    -->
    <style name="Theme.QuestionSolver" parent="Theme.Material3.DynamicColors.DayNight.NoActionBar">
        <!-- 状态栏 / 导航栏透明，让 Compose 内容自己绘制沉浸式背景 -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
    </style>

    <style name="Theme.QuestionSolver.NoActionBar" parent="Theme.QuestionSolver">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="SectionTitleText" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <style name="AnswerLabel" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>
</resources>
